        // State Aplikasi CBT
        let currentIdx = 0;
        let userFullname = localStorage.getItem('cbt_user_fullname') || "";
        let userSchool = localStorage.getItem('cbt_user_school') || "";
        let userAnswers = JSON.parse(localStorage.getItem('cbt_answers')) || {};
        let flaggedQuestions = JSON.parse(localStorage.getItem('cbt_flags')) || {};
        let totalSeconds = parseInt(localStorage.getItem('cbt_timer')) || (45 * 60); // 45 Menit = 2700 Detik
        let timerInterval;

        function startExamWithCredentials(e) {
            e.preventDefault();
            const nameInput = document.getElementById('user-fullname').value.trim();
            const schoolInput = document.getElementById('user-school').value.trim();

            if (!nameInput || !schoolInput) {
                alert("Mohon isi Nama Lengkap dan Asal Sekolah.");
                return;
            }

            userFullname = nameInput;
            userSchool = schoolInput;

            localStorage.setItem('cbt_user_fullname', userFullname);
            localStorage.setItem('cbt_user_school', userSchool);

            document.getElementById('login-modal').style.display = 'none';
            initExamUI();
        }

        function checkUserLogin() {
            if (userFullname && userSchool) {
                document.getElementById('login-modal').style.display = 'none';
                initExamUI();
            } else {
                document.getElementById('login-modal').style.display = 'flex';
            }
        }

        function initExamUI() {
            document.getElementById('display-fullname').textContent = userFullname;
            document.getElementById('display-school').textContent = userSchool;

            renderGrid();
            loadQuestion(currentIdx);
            startTimer();
            updateAnsweredBadge();
        }

        function setFontSize(size) {
            document.body.style.fontSize = size;
            document.querySelectorAll('.btn-size').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');
        }

        function startTimer() {
            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                totalSeconds--;
                localStorage.setItem('cbt_timer', totalSeconds);
                if (totalSeconds <= 0) {
                    clearInterval(timerInterval);
                    autoSubmit();
                }
                updateTimerDisplay();
            }, 1000);
        }

        function updateTimerDisplay() {
            const h = Math.floor(totalSeconds / 3600).toString().padStart(2, '0');
            const m = Math.floor((totalSeconds % 3600) / 60).toString().padStart(2, '0');
            const s = (totalSeconds % 60).toString().padStart(2, '0');
            
            document.getElementById('timer-display').textContent = `${h}:${m}:${s}`;

            const timerBox = document.getElementById('timer-box');
            if (totalSeconds < 300) { // < 5 menit
                timerBox.className = 'timer-box danger';
            } else if (totalSeconds < 600) { // < 10 menit
                timerBox.className = 'timer-box warning';
            }
        }

        function renderGrid() {
            const gridContainer = document.getElementById('question-grid');
            gridContainer.innerHTML = '';

            questionsData.forEach((q, idx) => {
                const item = document.createElement('div');
                item.className = 'grid-item';
                item.textContent = q.id;

                if (idx === currentIdx) item.classList.add('active');
                if (flaggedQuestions[q.id]) {
                    item.classList.add('flagged');
                } else if (userAnswers[q.id] && userAnswers[q.id].length > 0) {
                    item.classList.add('answered');
                }

                item.onclick = () => {
                    currentIdx = idx;
                    loadQuestion(currentIdx);
                    renderGrid();
                };

                gridContainer.appendChild(item);
            });
        }

        function loadQuestion(idx) {
            const q = questionsData[idx];

            document.getElementById('passage-title').textContent = q.title;
            document.getElementById('passage-content').textContent = q.passage;
            document.getElementById('question-number-text').textContent = `Soal Nomor ${q.id}`;
            document.getElementById('question-text').textContent = q.question;

            const isMulti = q.key.includes(',');
            document.getElementById('question-type-badge').textContent = isMulti ? 'Pilihan Ganda Kompleks' : 'Pilihan Ganda';

            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';

            const currentAns = userAnswers[q.id] || [];

            Object.keys(q.options).forEach(key => {
                const optItem = document.createElement('div');
                optItem.className = 'option-item';
                if (currentAns.includes(key)) optItem.classList.add('selected');

                const inputType = isMulti ? 'checkbox' : 'radio';

                optItem.innerHTML = `
                    <input type="${inputType}" name="option" value="${key}" ${currentAns.includes(key) ? 'checked' : ''}>
                    <div class="option-label"><strong>${key}.</strong> ${q.options[key]}</div>
                `;

                optItem.onclick = (e) => {
                    if (isMulti) {
                        if (userAnswers[q.id]?.includes(key)) {
                            userAnswers[q.id] = userAnswers[q.id].filter(k => k !== key);
                        } else {
                            userAnswers[q.id] = [...(userAnswers[q.id] || []), key];
                        }
                    } else {
                        userAnswers[q.id] = [key];
                    }
                    localStorage.setItem('cbt_answers', JSON.stringify(userAnswers));
                    loadQuestion(currentIdx);
                    renderGrid();
                    updateAnsweredBadge();
                };

                optionsContainer.appendChild(optItem);
            });

            document.getElementById('btn-prev').disabled = (idx === 0);
            document.getElementById('btn-next').disabled = (idx === questionsData.length - 1);

            const flagBtn = document.getElementById('btn-flag');
            if (flaggedQuestions[q.id]) {
                flagBtn.style.opacity = '0.8';
                flagBtn.textContent = 'Ragu-Ragu (Aktif)';
            } else {
                flagBtn.style.opacity = '1';
                flagBtn.textContent = 'Ragu-Ragu';
            }
        }

        function updateAnsweredBadge() {
            let count = Object.keys(userAnswers).filter(k => userAnswers[k].length > 0).length;
            document.getElementById('answered-count-badge').textContent = `${count}/30`;
        }

        function prevQuestion() {
            if (currentIdx > 0) {
                currentIdx--;
                loadQuestion(currentIdx);
                renderGrid();
            }
        }

        function nextQuestion() {
            if (currentIdx < questionsData.length - 1) {
                currentIdx++;
                loadQuestion(currentIdx);
                renderGrid();
            }
        }

        function toggleFlag() {
            const qId = questionsData[currentIdx].id;
            flaggedQuestions[qId] = !flaggedQuestions[qId];
            localStorage.setItem('cbt_flags', JSON.stringify(flaggedQuestions));
            loadQuestion(currentIdx);
            renderGrid();
        }

        function confirmSubmit() {
            let answered = Object.keys(userAnswers).filter(k => userAnswers[k].length > 0).length;
            if (confirm(`Anda telah menjawab ${answered} dari 30 soal. Yakin ingin menyelesaikan ujian?`)) {
                finishExam();
            }
        }

        function autoSubmit() {
            alert("Waktu pengerjaan ujian (45 menit) telah habis! Jawaban Anda otomatis terselesaikan dan dikirim.");
            finishExam();
        }

        function finishExam() {
            clearInterval(timerInterval);

            let correct = 0;
            const reviewContainer = document.getElementById('review-container');
            reviewContainer.innerHTML = '';

            const resultPayload = {
                timestamp: new Date().toLocaleString('id-ID'),
                fullname: userFullname,
                school: userSchool,
                answers: {}
            };

            questionsData.forEach(q => {
                const userAnsList = (userAnswers[q.id] || []).sort();
                const userAnsStr = userAnsList.join(', ');
                const isCorrect = (userAnsStr === q.key);

                if (isCorrect) correct++;
                resultPayload.answers[`Soal_${q.id}`] = userAnsStr || "Kosong";

                const reviewItem = document.createElement('div');
                reviewItem.className = `review-item ${isCorrect ? 'correct' : 'incorrect'}`;
                
                reviewItem.innerHTML = `
                    <div style="font-weight: 700; margin-bottom: 6px;">
                        Soal Nomor ${q.id}
                        <span class="status-tag ${isCorrect ? 'correct' : 'incorrect'}">${isCorrect ? 'BENAR' : 'SALAH'}</span>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>Pertanyaan:</strong> ${q.question}</div>
                    <div style="font-size: 0.9rem;"><strong>Jawaban Anda:</strong> ${userAnsStr || 'Tidak Dijawab'}</div>
                    <div style="font-size: 0.9rem; color: var(--success); font-weight: 600;"><strong>Kunci Jawaban:</strong> ${q.key}</div>
                    <div class="explanation-box">
                        <strong>Pembahasan:</strong> ${q.pembahasan}
                    </div>
                `;

                reviewContainer.appendChild(reviewItem);
            });

            const score = Math.round((correct / questionsData.length) * 100);
            resultPayload.score = score;
            resultPayload.correct = correct;
            resultPayload.incorrect = questionsData.length - correct;

            const timeSpentSec = (45 * 60) - totalSeconds;
            const h = Math.floor(timeSpentSec / 3600).toString().padStart(2, '0');
            const m = Math.floor((timeSpentSec % 3600) / 60).toString().padStart(2, '0');
            const s = (timeSpentSec % 60).toString().padStart(2, '0');
            const timeUsedStr = `${h}:${m}:${s}`;
            resultPayload.timeUsed = timeUsedStr;

            document.getElementById('final-score').textContent = score;
            document.getElementById('correct-count').textContent = correct;
            document.getElementById('incorrect-count').textContent = questionsData.length - correct;
            document.getElementById('result-fullname').textContent = userFullname;
            document.getElementById('result-school').textContent = userSchool;
            document.getElementById('time-used').textContent = timeUsedStr;

            document.getElementById('result-modal').style.display = 'flex';

            // Mengirim data otomatis ke Google Apps Script Web App (Metode text/plain yang Lolos CORS di HP/Browser)
            if (GOOGLE_APPS_SCRIPT_URL) {
                fetch(GOOGLE_APPS_SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(resultPayload)
                }).catch(err => console.log('Error pengiriman data otomatis:', err));
            }
        }

        function downloadSpreadsheetCSV() {
            let csvContent = "data:text/csv;charset=utf-8,";
            
            let headers = ["Waktu Submit", "Nama Lengkap", "Asal Sekolah", "Skor Akhir", "Jumlah Benar", "Jumlah Salah", "Waktu Pengerjaan"];
            for (let i = 1; i <= 30; i++) {
                headers.push(`Soal ${i}`);
            }
            csvContent += headers.map(h => `"${h}"`).join(",") + "\n";

            let row = [
                new Date().toLocaleString('id-ID'),
                userFullname,
                userSchool,
                document.getElementById('final-score').textContent,
                document.getElementById('correct-count').textContent,
                document.getElementById('incorrect-count').textContent,
                document.getElementById('time-used').textContent
            ];

            for (let i = 1; i <= 30; i++) {
                let ans = (userAnswers[i] || []).sort().join(', ');
                row.push(ans || "Kosong");
            }

            csvContent += row.map(r => `"${r}"`).join(",") + "\n";

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Hasil_TKAD_${userFullname.replace(/\s+/g, '_')}_${userSchool.replace(/\s+/g, '_')}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function resetExam() {
            if (confirm("Mulai ulang ujian? Seluruh data pengerjaan akan direset.")) {
                localStorage.removeItem('cbt_answers');
                localStorage.removeItem('cbt_flags');
                localStorage.removeItem('cbt_timer');
                localStorage.removeItem('cbt_user_fullname');
                localStorage.removeItem('cbt_user_school');
                location.reload();
            }
        }

        window.onload = checkUserLogin;
    </script>
